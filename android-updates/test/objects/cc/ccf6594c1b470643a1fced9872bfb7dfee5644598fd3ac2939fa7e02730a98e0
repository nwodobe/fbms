/* LBA Purchase — création LBA + rubrique Achats RCN, sans jargon technique visible. */
(function(global){
'use strict';
var root=null,sb=null,profile={};
function esc(v){return String(v==null?'':v).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
function n(v){var x=Number(v||0);return isFinite(x)?x:0;}
function money(v){return new Intl.NumberFormat('fr-FR',{maximumFractionDigits:0}).format(n(v))+' FCFA';}
function date(v){if(!v)return '—';try{return new Intl.DateTimeFormat('fr-FR').format(new Date(v));}catch(e){return esc(v);}}
function badge(s){var x=String(s||'').toUpperCase(),c=/REFUS|BLOQ|ERREUR/.test(x)?'danger':/APPROUV|ACTIF|PAYE|LIBERE/.test(x)?'ok':/ATTENT|SOUMIS|PENDING/.test(x)?'warn':'info';return '<span class="badge '+c+'">'+esc(s||'—')+'</span>';}
function route(){return (location.hash||'#overview').slice(1).split('/')[0]||'overview';}
function canManageLba(){return ['Procurement Officer','Supervisor','Branch Manager','Assistant Branch Manager','Coordination','Administrateur'].indexOf(profile.role)>=0;}
function ensureClient(){if(sb)return sb;if(global.supabase&&global.ANAGROCI_SUPABASE_URL&&global.ANAGROCI_SUPABASE_ANON){sb=global.supabase.createClient(global.ANAGROCI_SUPABASE_URL,global.ANAGROCI_SUPABASE_ANON);}return sb;}
async function loadProfile(){var c=ensureClient();if(!c)return;var s=await c.auth.getSession(),u=s.data&&s.data.session&&s.data.session.user;if(!u)return;var r=await c.from('profils').select('nom,role,actif').eq('user_id',u.id).maybeSingle();if(!r.error&&r.data)profile=r.data;}
async function suppliers(){var c=ensureClient();if(!c)return[];var r=await c.from('rcn_fournisseurs').select('code,nom,categorie,statut,contrat,origines,sites,created_at').like('code','LBA-%').order('code',{ascending:true});if(r.error)throw r.error;return r.data||[];}
function slug3(name){var s=String(name||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().replace(/\b(RCN|SCOOPS?|COOP(?:ERATIVE)?|CA)\b/g,' ').replace(/[^A-Z0-9]+/g,'').slice(0,3);return (s+'XXX').slice(0,3);}
function nextCode(rows,name){var mx=0;(rows||[]).forEach(function(x){var m=String(x.code||'').match(/^LBA-(\d{3})-/);if(m)mx=Math.max(mx,Number(m[1]));});return 'LBA-'+String(mx+1).padStart(3,'0')+'-'+slug3(name);}
function field(label,input,span){return '<div class="ops-field '+(span?'ops-span-2':'')+'"><label>'+label+'</label>'+input+'</div>';}
async function openCreate(){
 var rows=await suppliers(),host=document.getElementById('lbaCreateHost');if(!host){host=document.createElement('section');host.id='lbaCreateHost';host.className='ops-form-card';var head=document.querySelector('.ops-route-head');if(head)head.insertAdjacentElement('afterend',host);else root.prepend(host);}
 if(!canManageLba()){host.innerHTML='<div class="notice danger"><b>Création non autorisée pour ce profil.</b> Votre rôle actuel est '+esc(profile.role||'non identifié')+'.</div>';return;}
 host.hidden=false;host.innerHTML='<h3>Créer un nouveau LBA</h3><p class="muted">Enregistrez d’abord le LBA dans le référentiel. Vous pourrez ensuite définir sa limite, son financement et suivre ses achats RCN.</p><form id="lbaCreateForm"><div class="ops-form-grid">'+
 field('Nom du LBA','<input id="lba_name" required placeholder="Ex. COOPERATIVE EXEMPLE">')+
 field('Code LBA','<input id="lba_code" required pattern="LBA-[0-9]{3}-[A-Z0-9]{3}" placeholder="LBA-024-EXE">')+
 field('Origine / zone (facultatif)','<input id="lba_origins" placeholder="Ex. Bouaké, Korhogo">')+
 field('Site de livraison habituel (facultatif)','<input id="lba_sites" placeholder="Ex. Yamoussoukro">')+
 field('Contrat','<select id="lba_contract"><option value="false">Non</option><option value="true">Oui</option></select>')+
 '</div><div class="ops-actions" style="margin-top:12px"><button class="btn primary" type="submit">Créer le LBA</button><button class="btn secondary" type="button" id="lbaCancel">Annuler</button></div><div id="lbaCreateMsg" class="muted" style="margin-top:10px"></div></form>';
 var name=document.getElementById('lba_name'),code=document.getElementById('lba_code');code.value=nextCode(rows,'XXX');
 name.addEventListener('input',function(){var cur=code.value.match(/^LBA-(\d{3})-/),num=cur?cur[1]:String(rows.length+1).padStart(3,'0');code.value='LBA-'+num+'-'+slug3(name.value);});
 document.getElementById('lbaCancel').onclick=function(){host.hidden=true;};
 document.getElementById('lbaCreateForm').addEventListener('submit',async function(e){e.preventDefault();var msg=document.getElementById('lbaCreateMsg'),nom=name.value.trim(),cd=code.value.trim().toUpperCase();msg.className='muted';msg.textContent='Création…';if(!/^LBA-\d{3}-[A-Z0-9]{3}$/.test(cd)){msg.className='ops-danger-text';msg.textContent='Format attendu : LBA-024-ABC.';return;}var dup=rows.filter(function(x){return x.code===cd||String(x.nom||'').trim().toUpperCase()===nom.toUpperCase();})[0];if(dup){msg.className='ops-danger-text';msg.textContent='Ce LBA existe déjà : '+dup.code+' · '+dup.nom;return;}var origins=document.getElementById('lba_origins').value.split(',').map(function(x){return x.trim();}).filter(Boolean),sites=document.getElementById('lba_sites').value.split(',').map(function(x){return x.trim();}).filter(Boolean);var r=await ensureClient().from('rcn_fournisseurs').insert({code:cd,nom:nom,categorie:'LBA',statut:'ACTIF',contrat:document.getElementById('lba_contract').value==='true',origines:origins,sites:sites,source_fichier:'ANAGROCI Operations · création manuelle'});if(r.error){msg.className='ops-danger-text';msg.textContent=r.error.message;return;}msg.className='ops-ok-text';msg.textContent='LBA créé : '+cd+'. Ouverture du LBA Passport…';setTimeout(function(){location.hash='#registry/'+encodeURIComponent(cd);},500);});
}
function injectRegistryActions(){var bar=document.querySelector('.ops-route-actions');if(!bar||document.getElementById('newLbaBtn'))return;var b=document.createElement('button');b.id='newLbaBtn';b.type='button';b.className='btn primary';b.textContent='+ Nouveau LBA';b.onclick=openCreate;bar.appendChild(b);}
function injectOverviewAction(){var bar=document.querySelector('.ops-route-actions');if(!bar||document.getElementById('newLbaBtn'))return;var b=document.createElement('button');b.id='newLbaBtn';b.type='button';b.className='btn primary';b.textContent='+ Nouveau LBA';b.onclick=function(){location.hash='#registry';setTimeout(openCreate,150);};bar.appendChild(b);}
async function renderPurchases(){
 root=document.getElementById('opsRouteView');var c=ensureClient();if(!c){root.innerHTML='<div class="notice danger">Connexion aux données indisponible.</div>';return;}
 root.innerHTML='<div class="empty">Chargement des achats RCN…</div>';var all=await suppliers();var r=await c.from('rcn_proc_validations_achat').select('id,reception_id,supplier_code,supplier_name,poids_paye_kg,prix_soumis_bm,montant_soumis,prix_approuve_gm,montant_approuve,statut,submitted_at,decided_at').like('supplier_code','LBA-%').order('submitted_at',{ascending:false}).limit(500);if(r.error){root.innerHTML='<div class="notice danger"><b>Erreur :</b> '+esc(r.error.message)+'</div>';return;}var rows=r.data||[],totalKg=rows.reduce(function(t,x){return t+n(x.poids_paye_kg);},0),approved=rows.filter(function(x){return /APPROUV/.test(String(x.statut||''));}),approvedAmount=approved.reduce(function(t,x){return t+n(x.montant_approuve||x.montant_soumis);},0),pending=rows.filter(function(x){return /SOUMIS|ATTENT/.test(String(x.statut||''));}).length,activeLba={};rows.forEach(function(x){if(x.supplier_code)activeLba[x.supplier_code]=1;});var options=all.map(function(x){return '<option value="'+esc(x.code)+'">'+esc(x.code+' · '+x.nom)+'</option>';}).join('');
 root.innerHTML='<div class="ops-route-head"><div><h1>Achats RCN des LBA</h1><p>Suivi des achats soumis et approuvés pour chaque LBA.</p></div><div class="ops-route-actions"><a class="btn secondary" href="#registry">Voir les LBA</a></div></div><section class="kpi-grid"><div class="kpi"><small>Dossiers d’achat</small><b>'+rows.length+'</b><span>enregistrés</span></div><div class="kpi"><small>LBA avec achats</small><b>'+Object.keys(activeLba).length+'</b><span>sur '+all.length+' LBA</span></div><div class="kpi"><small>Poids payé</small><b>'+(totalKg/1000).toLocaleString('fr-FR',{maximumFractionDigits:1})+' MT</b><span>tous statuts</span></div><div class="kpi"><small>Montant approuvé</small><b>'+money(approvedAmount)+'</b><span>dossiers approuvés</span></div><div class="kpi '+(pending?'warn':'')+'"><small>En attente</small><b>'+pending+'</b><span>à traiter</span></div></section><section class="card"><div class="card-head"><div><h2>Historique des achats</h2><p>Filtrez par LBA pour voir ce qu’il a acheté et le statut du dossier.</p></div><div class="ops-route-actions"><select id="purchaseLbaFilter"><option value="">Tous les LBA</option>'+options+'</select></div></div><div id="purchaseTable"></div></section>';
 function draw(code){var list=rows.filter(function(x){return !code||x.supplier_code===code;});document.getElementById('purchaseTable').innerHTML=list.length?'<div class="table-wrap"><table><thead><tr><th>Date</th><th>LBA</th><th>Réception</th><th>Poids payé</th><th>Prix soumis</th><th>Montant</th><th>Statut</th></tr></thead><tbody>'+list.map(function(x){return '<tr><td>'+date(x.submitted_at)+'</td><td><b>'+esc(x.supplier_code)+'</b><br><span class="muted">'+esc(x.supplier_name||'')+'</span></td><td class="mono">'+esc(x.reception_id||'—')+'</td><td>'+n(x.poids_paye_kg).toLocaleString('fr-FR')+' kg</td><td>'+money(x.prix_approuve_gm||x.prix_soumis_bm).replace(' FCFA','')+' / kg</td><td>'+money(x.montant_approuve||x.montant_soumis)+'</td><td>'+badge(x.statut)+'</td></tr>';}).join('')+'</tbody></table></div>':'<div class="ops-empty">Aucun achat RCN pour ce LBA.</div>';}
 draw('');document.getElementById('purchaseLbaFilter').addEventListener('change',function(){draw(this.value);});
}
async function postProcess(){var r=route();if(r==='registry')injectRegistryActions();else if(r==='overview')injectOverviewAction();}
async function init(){root=document.getElementById('opsRouteView');ensureClient();await loadProfile();var original=global.ANAGROCI_OPS_ROUTE||global.ANAGROCI_LBA&&global.ANAGROCI_LBA.render;if(!original)return;async function routed(){if(route()==='purchases'){await renderPurchases();return;}await original();postProcess();}global.ANAGROCI_OPS_ROUTE=routed;if(global.ANAGROCI_LBA)global.ANAGROCI_LBA.render=routed;if(route()==='purchases')await renderPurchases();else postProcess();}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(init,0);});else setTimeout(init,0);
})(window);
