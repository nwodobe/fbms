function renderLocal(){const la=pendingCount("anagroci_achats"), lav=pendingCount("anagroci_avances"), lr=pendingCount("anagroci_recons"), ls=pendingCount("anagroci_sacs");$("lAch").textContent=fmt(la);$("lCash").textContent=fmt(lav+lr);$("lSacs").textContent=fmt(ls);const fails=failedCount("anagroci_achats")+failedCount("anagroci_avances")+failedCount("anagroci_recons")+failedCount("anagroci_sacs");$("localHints").innerHTML=fails?'<span class="badge bhi">'+fails+' échec(s) de synchronisation à vérifier</span>':'<span class="badge blo">File locale normale</span>';return {pending:la+lav+lr+ls,failed:fails};}

/* ==========================================================================
   Zones AFLP — LUES, jamais recalculées
   --------------------------------------------------------------------------
   La répartition GBEKE 1 / GBEKE 2 appartient au moteur IA
   (`shared/aflp-ia-moteur.js`). On la relit par `AFLP_IA_UI.etatCourant()`
   plutôt que d'en recopier une seconde table ici : deux tables pour une même
   vérité finissent toujours par diverger. Si le moteur n'a pas encore tourné,
   la zone vaut « — » et rien n'est inventé.
   ====================================================================== */
function zonesParCluster(){
  var m={};
  try{
    var e=window.AFLP_IA_UI&&AFLP_IA_UI.etatCourant?AFLP_IA_UI.etatCourant().etat:null;
    if(e&&e.clusters)Object.keys(e.clusters).forEach(function(k){
      var c=e.clusters[k];if(c&&c.zone)m[k]=c.zone;
    });
  }catch(err){/* le moteur n'est pas monté : on affichera « — » */}
  return m;
}
function zonesConfirmees(){
  try{
    var e=window.AFLP_IA_UI&&AFLP_IA_UI.etatCourant?AFLP_IA_UI.etatCourant().etat:null;
    return !!(e&&e.referentiel&&e.referentiel.zonesConfirmees);
  }catch(err){return false;}
}

