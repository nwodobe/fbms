/* ==========================================================================
   Prévisions AFLP — bandeau de page et grille de cartes
   --------------------------------------------------------------------------
   Le module `AFLP_PRED_UI` garde la charge de CALCULER et d'AFFICHER chaque
   analyse. La page ne fait que remplacer son ruban d'onglets par une grille
   de cartes : chaque carte pilote l'onglet correspondant du module. Les
   libellés sont LUS sur les boutons du module — recopiés ici, ils finiraient
   par diverger des siens.
   ====================================================================== */
function renderPredGrille(){
  var g=$("predGrille");if(!g)return;
  var boutons=Array.prototype.slice.call(document.querySelectorAll("#aflpPred .aflpp-tab"));
  if(!boutons.length){g.innerHTML="";return;}
  g.innerHTML=boutons.map(function(b,i){
    var cle=b.getAttribute("data-onglet"),actif=b.getAttribute("aria-selected")==="true";
    return '<button class="carte" type="button" data-pred="'+esc(cle)+'" aria-pressed="'+(actif?"true":"false")+'">'+
      '<span class="hd"><span class="no">'+String(i+1).padStart(2,"0")+'</span>'+
      '<span class="nm">'+esc(b.textContent)+'</span></span></button>';
  }).join("");
}
function majBandeauPred(){
  var r=window.AFLP_PRED_UI&&AFLP_PRED_UI.resume?AFLP_PRED_UI.resume():null;
  var c=$("cntPrev");
  if(!r){if(c)c.className="cnt";return;}
  /* Le statut shadow est une information permanente du niveau 3, pas un
     compteur : la pastille le dit en toutes lettres. */
  if(c)c.className="cnt on wa";
  var porte=r.porteFranchie===null?"—":(r.porteFranchie?"franchie":"non franchie");
  $("predMention").textContent="Porte du Niveau 1 "+porte+
    (r.porteFranchie===false&&r.p0Ouverts?" : "+r.p0Ouverts+" prérequis P0 ouvert(s). Aucun modèle ne peut dépasser SHADOW_ONLY.":".");
  /* L'étiquette est isolée dans son propre nœud de texte : accolée au chiffre,
     « modèle 3.0.0 » ne peut plus correspondre exactement dans le dictionnaire
     FR/EN, et il aurait fallu y inscrire « modèle » et « retard » comme clés
     globales — assez courtes pour couper « retardataire » ailleurs. */
  $("predMeta").innerHTML=
    '<span><span class="lb">modèle</span> '+esc(String(r.version||"—"))+'</span>'+
    '<span><span class="lb">calculé le</span> '+esc(String(r.dateRef||"—"))+'</span>'+
    (r.retardJours==null?"":'<span><span class="lb">retard</span> '+esc(String(r.retardJours))+' j</span>');
  /* Encart dérive : le motif vient du moteur prédictif, il n'est pas rédigé
     ici. Tant que l'analyse n'a pas abouti, l'encart le dit. */
  var d=r.derive,txt=d&&d.motif?d.motif:(d&&d.derive?"Dérive détectée sur la période.":null);
  if(txt){$("deriveSynthese").textContent=txt;$("deriveRisques").textContent=txt;}
}

/* Résumé d'en-tête de l'Assistant IA : lu par le module, jamais recalculé —
   voir AFLP_IA_UI.resume(). */
function majResumesModules(){
  majBandeauPred();
  renderPredGrille();
  /* Ces deux rendus lisent la zone de chaque cluster sur le moteur IA. Leur
     premier passage, dans `loadAll`, a lieu AVANT `AFLP_IA_UI.rafraichir()` :
     la table des zones y est encore vide et la colonne affiche « — ». On les
     rejoue donc ici, une fois le moteur alimenté. Rejouer `renderZones()` sans
     `renderSacsCluster()` corrige la carte Zones AFLP et laisse le tableau
     « Sacs par cluster » avec ses tirets — constaté en production. */
  renderZones();
  renderSacsCluster();
}

/* ==========================================================================
