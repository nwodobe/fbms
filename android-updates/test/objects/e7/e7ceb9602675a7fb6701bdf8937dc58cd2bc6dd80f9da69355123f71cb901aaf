<script>
/* ============================================================================
   Le moteur métier de cette page n'a pas changé : mêmes tables interrogées,
   mêmes agrégats, mêmes seuils, mêmes libellés. Seule la mise en scène de
   l'information a été retravaillée — de sept blocs empilés à huit onglets.
   ========================================================================== */
const SUPABASE_URL="https://jmbdgpdthzpszfnddwzi.supabase.co";const SUPABASE_ANON="sb_publishable_Gu5j0VV4ymP-I9t3JriQXg_VlTJqV2d";const OBJECTIF_MT=11000;const $=i=>document.getElementById(i);let SB,OBJ_COUT=8,LOAD_ERR=0,LOAD_DONE=false,LOAD_TIMER=null;
/* État d'affichage — jamais de règle métier ici, seulement ce qui est montré. */
let CLUSTERS=[],RT_ROWS=[],TODO_ITEMS=[],AV_ROWS=[],SACS_ROWS=[],RT_ALL=false,TODO_ALL=false,LAST_LOAD=0;
const TODO_APERCU=5,RT_APERCU=3,BOUGE_APERCU=3;
const PRIORITE={hi:"Critique",md:"Attention",lo:"Information"};

function esc(s){return String(s==null?"":s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));}
function fmt(x){return x==null||isNaN(x)?"—":Math.round(x).toLocaleString("fr-FR");}
function mt(kg){return (Math.round(((Number(kg)||0)/1000)*10)/10).toLocaleString("fr-FR");}
function keyc(s){return String(s||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toUpperCase().replace(/[^A-Z0-9]/g,"");}
function up(s){return String(s==null?"":s).toUpperCase();}
function today(){const d=new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");}
async function q(table,sel,mod){try{let r=SB.from(table).select(sel||"*");if(mod)r=mod(r);const res=await r;if(res.error){LOAD_ERR++;return [];}return res.data||[];}catch(e){LOAD_ERR++;return [];}}

/* ==========================================================================
   Navigation par onglets — un seul niveau, état porté par l'URL
   --------------------------------------------------------------------------
   Les ancres historiques (#sec-synthese, #sec-traiter, #sec-terrain,
   #sec-risques, #sec-ia, #sec-previsions) sont CONSERVÉES à l'identique : un
   lien en circulation vers l'une d'elles ouvre l'onglet correspondant au lieu
   de faire défiler. Deux ancres s'y ajoutent, #sec-caisse et #sec-sacs.
   ====================================================================== */
const ONGLETS=["sec-synthese","sec-traiter","sec-terrain","sec-risques","sec-caisse","sec-sacs","sec-ia","sec-previsions"];
let ONGLET_ACTIF=ONGLETS[0];
function hauteurBarre(){var b=document.getElementById("anagroci-suite-bar");return b?b.offsetHeight:0;}
function majOffsets(){
  var h=hauteurBarre(),n=$("ccNav");
  document.documentElement.style.setProperty("--barh",h+"px");
  if(n)document.documentElement.style.setProperty("--navh",n.offsetHeight+"px");
}
/* L'onglet actif est ramené dans le champ de vision en agissant SUR LE SEUL
   défilement horizontal de la barre. `scrollIntoView` agirait aussi sur le
   document et ferait sauter la page au changement d'onglet. */
function centrerOnglet(t){
  var n=document.querySelector("#ccNav .ccnav-in");
  if(!n||n.scrollWidth<=n.clientWidth)return;
  var g=t.offsetLeft,d=g+t.offsetWidth;
  if(g<n.scrollLeft)n.scrollLeft=Math.max(0,g-12);
  else if(d>n.scrollLeft+n.clientWidth)n.scrollLeft=d-n.clientWidth+12;
}
function activerOnglet(id,focaliser){
  if(ONGLETS.indexOf(id)<0)id=ONGLETS[0];
  ONGLETS.forEach(function(s){
    var sec=$(s),t=$("tab-"+s),on=(s===id);
    if(sec)sec.hidden=!on;
    if(t){t.setAttribute("aria-selected",on?"true":"false");t.tabIndex=on?0:-1;}
  });
  var t=$("tab-"+id);
  if(t){centrerOnglet(t);if(focaliser)t.focus();}
  ONGLET_ACTIF=id;
  /* `replaceState` et non `pushState` : changer d'onglet n'est pas une
     navigation, le bouton « précédent » doit ramener à la page d'avant et non
     rejouer huit onglets. Le rechargement, lui, retrouve bien l'onglet. */
  if(history.replaceState)history.replaceState(null,"","#"+id);
}
function initOnglets(){
  majOffsets();
  var tabs=Array.prototype.slice.call(document.querySelectorAll("#ccNav .cc-tab"));
  tabs.forEach(function(t,i){
    t.addEventListener("click",function(){activerOnglet(t.getAttribute("data-sec"));});
    t.addEventListener("keydown",function(ev){
      var k=ev.key,j=-1;
      if(k==="ArrowRight")j=(i+1)%tabs.length;
      else if(k==="ArrowLeft")j=(i-1+tabs.length)%tabs.length;
      else if(k==="Home")j=0;
      else if(k==="End")j=tabs.length-1;
      if(j<0)return;
      ev.preventDefault();
      activerOnglet(tabs[j].getAttribute("data-sec"),true);
    });
  });
  window.addEventListener("resize",majOffsets);
  /* La barre suite est injectée après le chargement : on remesure une fois. */
  setTimeout(majOffsets,400);
  /* Lien profond et rechargement : l'ancre de l'URL fait foi. */
  window.addEventListener("hashchange",function(){
    var h=location.hash.slice(1);
    if(h&&h!==ONGLET_ACTIF&&ONGLETS.indexOf(h)>=0)activerOnglet(h);
  });
  activerOnglet(location.hash.slice(1)||ONGLETS[0]);
}

/* ==========================================================================
   États : squelette / vide / hors-ligne / erreur
   ====================================================================== */
