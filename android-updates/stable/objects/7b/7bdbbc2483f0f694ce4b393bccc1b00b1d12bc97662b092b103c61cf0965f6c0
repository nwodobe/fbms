/* Portail : 7e carte AFLP FIELD PROOF. Deux rangées de trois (inchangées), puis
   une carte pleine largeur, image à gauche. N'altère ni operations/portal-visual.css
   ni moto/portal-moto.css : ne s'applique qu'à .portal-grid-seven. */
.portal-grid-seven .portal-card-proof{grid-column:1/-1;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);min-height:0}
.portal-grid-seven .portal-card-proof .portal-card-media{height:100%;min-height:240px}
.portal-grid-seven .portal-card-proof .portal-card-media img{width:100%;height:100%;object-fit:cover;object-position:center center}
.portal-grid-seven .portal-card-proof .portal-card-body{align-self:center}
@media(max-width:1100px){.portal-grid-seven .portal-card-proof{grid-column:1/-1;max-width:none;justify-self:stretch}}
@media(max-width:820px){.portal-grid-seven .portal-card-proof{grid-template-columns:1fr}.portal-grid-seven .portal-card-proof .portal-card-media{min-height:0;aspect-ratio:16/9}}
@media(max-width:620px){.portal-grid-seven .portal-card-proof{grid-column:auto}.portal-grid-seven .portal-card-proof .portal-card-media{aspect-ratio:16/8.7}}
