/* ANAGROCI Operations — Offline First terrain.
   Couche unique pour FIELD BUYING : IndexedDB, file persistante, idempotence,
   cache de référentiels et synchronisation au retour du réseau.
   Le serveur reste l'autorité : aucune permission, avance ou règle métier n'est
   considérée définitive tant que l'opération n'est pas synchronisée. */
(function (global) {
'use strict';

var DB_NAME = 'anagroci_ops_offline';
var DB_VERSION = 1;
var STORE_META = 'meta';
var STORE_BUNDLES = 'bundles';
var STORE_OPS = 'operations';
var STORE_MAP = 'mappings';
var MAX_BATCH = 50;
var SYNC_INTERVAL = 60000;
var dbPromise = null;
var syncPromise = null;
var syncTimer = null;
var runtime = { syncing: false, done: 0, total: 0, lastError: null };
/* Version de diagnostic (incident SOUAFOUÈ KAN, 18/11/2026) : aucune opération
   locale n'est supprimée et aucun enrôlement local ne peut être annulé depuis
   le téléphone. Les preuves restent sur l'appareil jusqu'à la fin de l'enquête. */
var RETENTION_LOCK = true;
var ENROLL_TYPES = ['FARMER_ENROLL', 'COOP_FARMER_ENROLL'];
var MAX_ATTEMPTS = 10;
/* Historique des cycles de synchronisation (méta-données uniquement, aucune
   donnée personnelle). Les opérations elles-mêmes ne sont jamais tronquées. */
var EVENTS_KEY = 'sync_events';
var EVENTS_MAX = 300;

function nowIso() { return new Date().toISOString(); }
function uuid() {
  if (global.crypto && global.crypto.randomUUID) return global.crypto.randomUUID();
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
    var r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 3 | 8); return v.toString(16);
