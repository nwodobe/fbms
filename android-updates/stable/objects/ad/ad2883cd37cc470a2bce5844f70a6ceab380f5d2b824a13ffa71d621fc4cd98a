/* ANAGROCI Operations Suite — design system partagé.
   P0 UX/UI : 5 workspaces, états lisibles, mobile first, orange réservé aux alertes. */
:root{
  --forest:#053B23;--deep:#0A5531;--pine:#00712C;--emerald:#008F37;--grass:#2DA64F;
  --lime:#8DC556;--sprout:#B6DC8E;--pale:#E0F3DE;--mist:#F3F8F4;--orange:#EE9E00;
  --orange-pale:#FDF0D4;--ink:#26352D;--muted:#6E7B73;--line:#DDE6DF;--white:#fff;
  --danger:#B9382F;--danger-pale:#FCE9E7;--info:#2E6FA3;--info-pale:#EAF2F8;
  --font-display:'Archivo','Segoe UI',Arial,sans-serif;--font-body:'IBM Plex Sans','Segoe UI',Arial,sans-serif;
  --font-mono:'IBM Plex Mono',Consolas,monospace;--radius:14px;--shadow:0 14px 34px rgba(5,59,35,.08)
}
*{box-sizing:border-box}
html{background:var(--mist)}
body{margin:0;background:var(--mist);color:var(--ink);font-family:var(--font-body);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
button,input,select{font:inherit}
button,a,input,select{outline-offset:3px}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid rgba(238,158,0,.55)}
.ops-topbar{min-height:68px;background:var(--forest);color:#fff;display:flex;align-items:center;gap:18px;padding:10px 24px;position:sticky;top:0;z-index:30;box-shadow:0 1px 0 rgba(255,255,255,.1)}
.ops-brand{display:flex;align-items:center;gap:10px;min-width:220px}
.ops-brand img{width:34px;height:34px;object-fit:contain;background:#fff;border-radius:8px;padding:3px}
.ops-brand strong{font-family:var(--font-display);font-size:15px;letter-spacing:.01em}
.ops-brand small{display:block;color:#BFD6C6;font-size:10px;text-transform:uppercase;letter-spacing:.1em;margin-top:2px}
.ops-title{flex:1;min-width:180px}
.ops-title strong{font-family:var(--font-display);font-size:18px}
.ops-title small{display:block;color:#BFD6C6;font-size:11px;margin-top:2px}
.ops-top-actions{display:flex;align-items:center;gap:9px;flex-wrap:wrap;justify-content:flex-end}
.ops-pill{display:inline-flex;align-items:center;gap:6px;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.08);border-radius:999px;padding:7px 11px;font-size:11px;font-weight:700;white-space:nowrap}
.ops-pill.light{background:#fff;color:var(--forest);border-color:#fff}
.ops-pill .dot{width:7px;height:7px;border-radius:50%;background:var(--lime)}
.ops-back{display:inline-flex;align-items:center;gap:7px;color:#DCE9E0;font-size:12px;font-weight:700}
.ops-shell{display:grid;grid-template-columns:220px minmax(0,1fr);min-height:calc(100vh - 68px)}
.ops-sidebar{background:#fff;border-right:1px solid var(--line);padding:18px 12px;position:sticky;top:68px;height:calc(100vh - 68px);overflow:auto}
.ops-side-head{font-size:10px;font-weight:800;letter-spacing:.12em;color:var(--pine);text-transform:uppercase;padding:4px 10px 10px}
.ops-nav{display:flex;flex-direction:column;gap:3px}
.ops-nav a{display:flex;align-items:center;gap:9px;min-height:42px;border-radius:10px;padding:9px 10px;color:#516159;font-size:12.5px;font-weight:600}
.ops-nav a:hover{background:var(--mist);color:var(--forest)}
.ops-nav a.active{background:var(--pale);color:var(--forest);font-weight:800}
.ops-nav .nav-dot{width:8px;height:8px;border-radius:50%;background:#C9D6CD;flex:0 0 auto}
.ops-nav a.active .nav-dot{background:var(--emerald)}
.ops-main{padding:26px;min-width:0}
.ops-pagehead{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:18px}
.ops-pagehead h1{font-family:var(--font-display);font-size:26px;line-height:1.15;margin:0;color:var(--forest);letter-spacing:-.02em}
.ops-pagehead p{margin:6px 0 0;color:var(--muted);font-size:13px;line-height:1.5;max-width:760px}
.ops-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.btn{min-height:42px;border:0;border-radius:10px;padding:10px 14px;font-weight:800;font-size:12px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px}
.btn.primary{background:var(--emerald);color:#fff}.btn.primary:hover{background:var(--pine)}
.btn.secondary{background:#fff;color:var(--forest);border:1px solid var(--line)}
.btn.signal{background:var(--orange-pale);color:#7A5200;border:1px solid #F2D79D}
.btn:disabled{opacity:.5;cursor:not-allowed}
.kpi-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-bottom:16px}
.kpi{background:#fff;border:1px solid var(--line);border-top:3px solid var(--lime);border-radius:12px;padding:13px 14px;min-height:93px;box-shadow:0 6px 18px rgba(5,59,35,.04)}
.kpi.attn{border-top-color:var(--orange)}.kpi.danger{border-top-color:var(--danger)}
.kpi small{display:block;text-transform:uppercase;letter-spacing:.07em;font-size:9px;color:var(--muted);font-weight:800}
.kpi b{display:block;margin-top:7px;font-family:var(--font-display);font-size:22px;color:var(--forest);line-height:1.05}
.kpi span{display:block;margin-top:5px;font-size:10px;color:#849088}
.grid-2{display:grid;grid-template-columns:1.35fr 1fr;gap:14px}.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px;min-width:0}
.card + .card{margin-top:14px}.card h2,.card h3{font-family:var(--font-display);color:var(--forest);margin:0}.card h2{font-size:16px}.card h3{font-size:14px}
.card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}.card-head p{margin:4px 0 0;color:var(--muted);font-size:11px}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:11px}
table{width:100%;border-collapse:collapse;font-size:11.5px;background:#fff;min-width:640px}
th{text-align:left;background:#EEF6F0;color:var(--forest);font-size:9.5px;text-transform:uppercase;letter-spacing:.05em;padding:10px;border-bottom:1px solid var(--line);position:sticky;top:0}
td{padding:10px;border-bottom:1px solid #EDF1EE;vertical-align:top}tr:last-child td{border-bottom:0}tbody tr:hover{background:#FBFDFB}
.mono{font-family:var(--font-mono);font-size:10.5px}.muted{color:var(--muted)}
.badge{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:4px 8px;font-size:9.5px;font-weight:800;white-space:nowrap;background:#EEF1EF;color:#506057}
.badge.ok{background:var(--pale);color:var(--pine)}.badge.warn{background:var(--orange-pale);color:#7A5200}.badge.danger{background:var(--danger-pale);color:var(--danger)}.badge.info{background:var(--info-pale);color:var(--info)}
.notice{display:flex;gap:10px;align-items:flex-start;border-radius:12px;padding:12px 14px;margin-bottom:14px;background:var(--orange-pale);border:1px solid #F0D69F;color:#694800;font-size:12px;line-height:1.5}
.notice.info{background:var(--info-pale);border-color:#CFE0ED;color:#245A82}.notice.ok{background:var(--pale);border-color:#C7E4C0;color:#195B2A}.notice.danger{background:var(--danger-pale);border-color:#EBC6C2;color:#7A2822}
/* Liste des jeux de données non chargés, dans un bandeau « Données partielles ». */
.ops-pannes{margin:6px 0 0;padding-left:18px}.ops-pannes li{margin-top:2px}.ops-pannes code{font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:11px}
.quick-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
.quick{border:1px solid var(--line);background:#fff;border-radius:11px;padding:13px;min-height:88px;display:flex;flex-direction:column;justify-content:space-between;transition:.16s ease}
.quick:hover{border-color:#B9D3C0;transform:translateY(-1px);box-shadow:0 8px 18px rgba(5,59,35,.07)}.quick b{font-size:12.5px;color:var(--forest)}.quick span{font-size:10.5px;color:var(--muted);line-height:1.35}.quick em{font-style:normal;color:var(--emerald);font-weight:800;font-size:10px;margin-top:8px}
.workflow{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.step{min-height:36px;display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:9px;padding:8px 10px;background:#fff;color:#607068;font-size:10px;font-weight:700}.step.done{background:var(--pale);color:var(--pine);border-color:#C7E4C0}.step.current{background:#ECF7EF;color:var(--forest);border-color:#A8D0B3}.step.pending{background:#FAFBFA}.step::after{content:'→';margin-left:5px;color:#A6B1AA}.step:last-child::after{display:none}
.bin-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px}.bin{border-radius:10px;padding:11px;border:1px solid #CDE2D2;background:#EFF8F1;min-height:74px}.bin.warn{background:var(--orange-pale);border-color:#EBCB87}.bin b{font:700 10.5px var(--font-mono);color:var(--forest)}.bin span{display:block;margin-top:6px;font-size:10px;color:var(--muted)}
.skeleton{height:18px;border-radius:7px;background:linear-gradient(90deg,#EDF1EE,#F8FAF8,#EDF1EE);background-size:200% 100%;animation:shimmer 1.2s linear infinite}@keyframes shimmer{to{background-position:-200% 0}}
.empty{padding:22px;text-align:center;color:var(--muted);font-size:12px}
.searchbar{display:flex;gap:8px;margin-bottom:14px}.searchbar input,.searchbar select,.field input,.field select{min-height:42px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink);padding:9px 11px;min-width:0}.searchbar input{flex:1}.searchbar select{min-width:170px}
.field{display:flex;flex-direction:column;gap:5px}.field label{font-size:9.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:800}
.form-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.portal-page{min-height:100vh;background:linear-gradient(180deg,#F6F9F6 0%,#EDF4EF 100%)}
.portal-wrap{max-width:1180px;margin:0 auto;padding:40px 24px 54px}.portal-head h1{font-family:var(--font-display);color:var(--forest);font-size:34px;letter-spacing:-.03em;margin:0}.portal-head p{margin:9px 0 0;color:var(--muted);font-size:14px}
.portal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:28px}.portal-card{background:#fff;border:1px solid var(--line);border-left:5px solid var(--emerald);border-radius:14px;padding:20px;min-height:160px;box-shadow:var(--shadow);transition:.16s ease;display:flex;flex-direction:column}.portal-card.signal{border-left-color:var(--orange)}.portal-card:hover{transform:translateY(-2px);box-shadow:0 18px 34px rgba(5,59,35,.12)}.portal-card small{color:var(--emerald);font-weight:900;font-size:10px;letter-spacing:.08em}.portal-card h2{font-family:var(--font-display);font-size:19px;color:var(--forest);margin:10px 0 6px}.portal-card p{font-size:12px;color:var(--muted);line-height:1.45;margin:0}.portal-card span{margin-top:auto;padding-top:18px;color:var(--emerald);font-weight:800;font-size:11px}.portal-wide{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}.portal-cross{background:var(--forest);color:#fff;border-radius:14px;padding:18px 20px;display:flex;align-items:center;justify-content:space-between;gap:15px}.portal-cross.light{background:#fff;color:var(--forest);border:1px solid var(--line)}.portal-cross h3{font-family:var(--font-display);font-size:17px;margin:0}.portal-cross p{font-size:11px;opacity:.78;margin:5px 0 0}.portal-cross b{white-space:nowrap;font-size:11px;color:var(--lime)}.portal-cross.light b{color:var(--emerald)}
.ops-footer{padding:20px 26px;color:#7F8B84;font-size:10px;text-align:center}
@media(max-width:1050px){.kpi-grid{grid-template-columns:repeat(3,1fr)}.portal-grid{grid-template-columns:repeat(2,1fr)}.grid-3{grid-template-columns:1fr 1fr}.form-grid{grid-template-columns:1fr 1fr}}
@media(max-width:820px){.ops-topbar{padding:10px 14px;gap:10px}.ops-brand{min-width:0}.ops-brand small{display:none}.ops-title{display:none}.ops-shell{display:block}.ops-sidebar{position:static;height:auto;border-right:0;border-bottom:1px solid var(--line);padding:9px;overflow:auto}.ops-side-head{display:none}.ops-nav{flex-direction:row;overflow:auto}.ops-nav a{white-space:nowrap;min-height:40px}.ops-main{padding:18px 14px}.grid-2{grid-template-columns:1fr}.kpi-grid{grid-template-columns:repeat(2,1fr)}.portal-wrap{padding:28px 14px 40px}.portal-head h1{font-size:28px}.portal-wide{grid-template-columns:1fr}.quick-grid{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.ops-top-actions .ops-pill:not(.light){display:none}.ops-pagehead{display:block}.ops-actions{justify-content:flex-start;margin-top:12px}.kpi-grid{grid-template-columns:1fr 1fr}.kpi b{font-size:19px}.portal-grid{grid-template-columns:1fr}.portal-card{min-height:145px}.quick-grid,.grid-3,.form-grid{grid-template-columns:1fr}.searchbar{flex-direction:column}.searchbar select{width:100%}.portal-cross{align-items:flex-start;flex-direction:column}.ops-main{padding-bottom:28px}}
