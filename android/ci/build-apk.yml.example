# =============================================================================
# Compilation reproductible de l'APK ANAGROCI FIELD BUYING sur GitHub Actions.
#
# CE FICHIER N'EST PAS ACTIF. La politique du dépôt (CLAUDE.md §3,
# .github/agent-policy/auto-merge-denylist.txt) interdit à un agent d'écrire
# dans .github/. Pour l'activer, un administrateur humain le copie dans :
#     .github/workflows/android-apk.yml
#
# Secrets à créer (Settings > Secrets and variables > Actions), JAMAIS dans le code :
#   ANAGROCI_KEYSTORE_BASE64   keystore release encodé : base64 -w0 anagroci-release.jks
#   ANAGROCI_KEYSTORE_PASSWORD mot de passe du keystore
#   ANAGROCI_KEY_ALIAS         alias de la clé (ex. anagroci)
#   ANAGROCI_KEY_PASSWORD      mot de passe de la clé
# Sans ces secrets, seul l'APK debug est produit.
#
# Coût : gratuit pour un dépôt public ; sur un dépôt privé, consomme les minutes
# Actions incluses dans l'offre GitHub (2 000 min/mois en offre gratuite à ce jour :
# à vérifier sur la page de facturation GitHub). Un build prend quelques minutes.
# L'APK est un « artifact » du workflow, visible des seuls membres du dépôt :
# il n'est PAS publié publiquement.
# =============================================================================
name: APK Android FIELD BUYING
on:
  workflow_dispatch: {}
  push:
    branches: [main]
    paths: ['android/**', 'operations/**', 'shared/**', 'assets/**', 'index.html']
permissions:
  contents: read
jobs:
  apk:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: '22' }
      - uses: actions/setup-java@v4
        with: { distribution: temurin, java-version: '17' }
      - name: Paquet Web embarqué
        run: node android/scripts/prepare-web.mjs
      - name: Tests JVM (AssetServer)
        run: |
          curl -sSL -o /tmp/json.jar https://repo1.maven.org/maven2/com/vaadin/external/google/android-json/0.0.20131108.vaadin1/android-json-0.0.20131108.vaadin1.jar
          JSON_JAR=/tmp/json.jar android/tests/jvm/run.sh
      - name: Simulation Android (Chromium)
        run: |
          npm install --no-save --no-package-lock playwright@1.56.1
          npx playwright install --with-deps chromium
          node android/tests/apk-webview-sim.mjs
      - name: Keystore release (si les secrets existent)
        env: { KS: '${{ secrets.ANAGROCI_KEYSTORE_BASE64 }}' }
        run: |
          if [ -n "$KS" ]; then echo "$KS" | base64 -d > "$RUNNER_TEMP/release.jks"; echo "ANAGROCI_KEYSTORE=$RUNNER_TEMP/release.jks" >> "$GITHUB_ENV"; fi
      - name: Gradle assembleDebug assembleRelease
        working-directory: android
        env:
          ANAGROCI_KEYSTORE_PASSWORD: ${{ secrets.ANAGROCI_KEYSTORE_PASSWORD }}
          ANAGROCI_KEY_ALIAS: ${{ secrets.ANAGROCI_KEY_ALIAS }}
          ANAGROCI_KEY_PASSWORD: ${{ secrets.ANAGROCI_KEY_PASSWORD }}
        run: ./gradlew --no-daemon assembleDebug assembleRelease
      - name: Vérification des signatures
        run: |
          APKSIGNER=$(ls $ANDROID_HOME/build-tools/*/apksigner | sort -V | tail -1)
          for f in android/app/build/outputs/apk/*/*.apk; do echo "== $f"; $APKSIGNER verify --print-certs "$f" | grep -E "DN|SHA-256" || echo "non signé"; done
          rm -f "$RUNNER_TEMP/release.jks"
      - uses: actions/upload-artifact@v4
        with:
          name: anagroci-field-buying-apk
          path: |
            android/app/build/outputs/apk/*/*.apk
            android/build/test-reports/*.json
          retention-days: 30
