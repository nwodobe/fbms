<!doctype html><html lang="fr"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#053B23">
<title>Command Center BM · ANAGROCI</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script defer src="../shared/auth-gate.js" data-module="command"></script>
<script defer src="../shared/suite-bar.js" data-module="CMD"></script>
<script defer src="../shared/aflp-ia-catalogue.js"></script>
<script defer src="../shared/aflp-ia-comprehension.js"></script>
<script defer src="../shared/aflp-ia-moteur.js"></script>
<script defer src="../shared/aflp-ia-journal.js"></script>
<script defer src="../shared/aflp-ia-langue.js"></script>
<script defer src="../shared/aflp-ia-ui.js"></script>
<script defer src="../shared/aflp-ia-predictif.js"></script>
<script defer src="../shared/aflp-ia-predictif-ui.js"></script>
<link rel="stylesheet" href="../shared/pjs-theme.css">
<style>
/* ============================================================================
   COMMAND CENTER BM — cockpit opérationnel
   ----------------------------------------------------------------------------
   Navigation en HUIT ONGLETS À UN SEUL NIVEAU. Un onglet, un sujet : le BM ne
   fait plus défiler sept blocs pour en lire un. Les sept panneaux inactifs
   portent `hidden` — ils ne sont ni peints, ni lus par un lecteur d'écran, ni
   atteignables au clavier.

   Contrat à ne pas casser : les identifiants (#kVol, #todo, #clusTable,
   #refTable, #rtTable, #aflpIa, #aflpPred…) et les classes .badge/.bhi/.bmd/
   .blo/.mini/.num/.neg/.pos/.state/.skel sont consommés par le script de la
   page ET par les modules partagés qui écrivent dedans. Les renommer casse
   silencieusement l'Assistant IA et les Prévisions.

   Aucune règle métier ici : mêmes tables, mêmes agrégats, mêmes seuils, mêmes
   libellés qu'avant. Seule la mise en scène change.
   ========================================================================== */
:root{
  --forest:#053B23;--emerald:#008F37;--pine:#00712C;--lime:#8DC556;
  --pale:#E0F3DE;--mist:#F1F9EF;--orange:#EE9E00;--orange-tint:#FDEFCE;
  --ink:#323131;--line:#E8E7E7;--danger:#C0392B;--white:#fff;
  --violet:#4A3C7A;
  /* Gris et ambre assombris par rapport au socle (#7A7878 / var(--amber-ink)) : mesurés
     à 4,38 et 4,30 de contraste, sous le seuil WCAG AA de 4,5 aux tailles
     employées ici. Ces deux valeurs-ci passent, sans changer la teinte. */
  --muted:#666565;--amber-ink:#8A5B00;
  --shadow:0 6px 18px rgba(5,59,35,.055);
  --shadow-lg:0 14px 34px rgba(5,59,35,.09);
  --r:12px;--r-sm:10px;
  --ease:cubic-bezier(0.22,1,0.36,1);
  --barh:50px;              /* hauteur réelle de la barre suite, mesurée au chargement */
  --navh:52px;              /* hauteur de la barre d'onglets */
  --stick:calc(var(--barh) + var(--navh));
}
*{box-sizing:border-box}
body{margin:0;background:#F6F8F5;color:var(--ink);font-family:'IBM Plex Sans',Arial,sans-serif}

/* Anneau de focus unique pour toute la page : émeraude 3px. Mesuré à 3,9 de
   contraste sur blanc et sur --mist, au-dessus du seuil de 3 exigé pour un
   composant d'interface. Une seule déclaration, pour qu'aucun contrôle ajouté
   plus tard n'échappe au clavier. */
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,
[tabindex]:focus-visible{outline:3px solid var(--emerald);outline-offset:2px}

/* ── Sous-en-tête du module ────────────────────────────────────────────── */
.top{background:radial-gradient(900px 420px at 85% -10%,#0d6b3e,transparent 55%),linear-gradient(135deg,#03301c,#053B23 60%,#0a4a2c);color:#eafff2;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:12px 18px;border-bottom:3px solid var(--lime)}
.top .b{display:flex;align-items:center;gap:14px;min-width:0}
.top b{font-size:17px;font-family:'Archivo',Arial,sans-serif;letter-spacing:-.01em}
.top small{color:#CFE3D3;font-size:11.5px}
.top .r{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
/* Plaque blanche du logo PJS : la marque officielle est en vert sur fond
   transparent, elle disparaît sur le vert forêt de l'en-tête. La plaque lui
   rend son contraste, le filet la sépare du bloc ANAGROCI. */
.plaque{background:#fff;border-radius:8px;padding:6px 10px;display:inline-flex;align-items:center;flex:none}
.plaque img{height:28px;width:auto;display:block}
.filet{width:1px;height:26px;background:rgba(255,255,255,.22);flex:none}
.upd{font-size:11.5px;color:#CFE3D3;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.upd::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--lime);flex:none}
.upd.stale::before{background:var(--orange)}
.upd.ko::before{background:#ff8f80}
.btn{border:0;border-radius:var(--r-sm);background:var(--emerald);color:#fff;font-weight:800;padding:0 14px;min-height:44px;cursor:pointer;font-size:13px;text-decoration:none;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;font-family:inherit;transition:background .16s var(--ease)}
.btn:hover{background:var(--pine)}
.btn.ghost{background:#fff;color:var(--forest)}
.btn.ghost:hover{background:var(--mist)}

/* ── Barre d'onglets collante, un seul niveau ──────────────────────────── */
.ccnav{position:sticky;top:var(--barh);z-index:900;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-bottom:1px solid var(--line);box-shadow:0 2px 10px rgba(5,59,35,.05)}
/* La barre défile horizontalement : à huit onglets, un retour à la ligne
   ferait sauter le contenu de 50 px selon la largeur de la fenêtre. */
.ccnav-in{max-width:1360px;margin:auto;display:flex;gap:2px;padding:0 12px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.ccnav-in::-webkit-scrollbar{display:none}
.cc-tab{flex:none;display:inline-flex;align-items:center;gap:7px;white-space:nowrap;min-height:52px;padding:0 15px;border:0;border-bottom:3px solid transparent;background:none;color:#5c6660;font-size:13.5px;font-weight:700;font-family:inherit;cursor:pointer;transition:color .16s var(--ease),background .16s var(--ease),border-color .16s var(--ease)}
.cc-tab:hover{background:var(--mist);color:var(--pine)}
.cc-tab[aria-selected="true"]{color:var(--forest);border-bottom-color:var(--emerald)}
.cc-tab:focus-visible{outline:3px solid var(--emerald);outline-offset:-3px}
.cc-tab .cnt{display:none;align-items:center;justify-content:center;white-space:nowrap;min-width:20px;height:20px;padding:0 7px;border-radius:999px;background:var(--pale);color:var(--pine);font-size:11px;font-weight:800;font-family:'IBM Plex Mono',monospace}
.cc-tab .cnt.on{display:inline-flex}
.cc-tab .cnt.hi{background:#fdeceb;color:var(--danger)}
.cc-tab .cnt.wa{background:var(--orange-tint);color:var(--amber-ink)}

/* ── Ossature ───────────────────────────────────────────────────────────── */
.wrap{max-width:1360px;margin:auto;padding:18px 14px 60px}
/* Règle d'auteur : elle bat le display du panneau, quel qu'il soit. */
.sec[hidden]{display:none}
.sec{animation:panIn .24s var(--ease)}
@keyframes panIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){.sec{animation:none}}
/* Le panneau porte `tabindex="0"` : après la barre d'onglets, la tabulation
   entre DANS le panneau actif. Il lui faut donc un focus visible comme à tout
   autre élément atteignable — un `outline:none` ici ferait disparaître le
   curseur clavier au premier Tab. L'anneau émeraude global s'applique. */
.sec:focus-visible{outline:3px solid var(--emerald);outline-offset:-3px}
.sec-h{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin:0 2px 14px}
.sec-h h2{margin:0;font-size:18px;font-family:'Archivo',Arial,sans-serif;color:var(--forest);letter-spacing:-.01em}
.sec-h .sub{font-size:12px;color:var(--muted)}
.sec-h .verdict{margin-left:auto;display:inline-flex;align-items:center;white-space:nowrap;font-size:11.5px;font-weight:800;border-radius:999px;padding:6px 13px}
.sec-h .verdict.ok{background:var(--pale);color:var(--pine)}
.sec-h .verdict.ko{background:#fdeceb;color:var(--danger)}
.g12{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}
.c4{grid-column:span 4}.c5{grid-column:span 5}.c7{grid-column:span 7}.c8{grid-column:span 8}.c12{grid-column:span 12}

.panel{background:#fff;border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);overflow:hidden;display:flex;flex-direction:column}
.panel h2{margin:0;padding:12px 15px;border-bottom:1px solid var(--line);color:var(--forest);font-size:14.5px;font-family:'Archivo',Arial,sans-serif;display:flex;justify-content:space-between;align-items:center;gap:10px}
.body{padding:13px 15px}
.mini{font-size:11px;color:var(--muted);font-weight:600}
.muted{color:var(--muted);font-size:12.5px}

/* ── Tuiles chiffrées (KPI et tuiles de section) ────────────────────────── */
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.tuiles{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.k{background:#fff;border:1px solid var(--line);border-left:4px solid var(--emerald);border-radius:var(--r);padding:14px 16px;box-shadow:var(--shadow)}
.k small{display:block;color:var(--muted);font-size:10.5px;font-weight:800;text-transform:uppercase;letter-spacing:.05em}
.k b{font-size:24px;color:var(--forest);font-family:'IBM Plex Mono',monospace;line-height:1.25;display:block;margin-top:4px}
.k .sub{font-size:11.5px;color:var(--muted);margin-top:4px;line-height:1.4}
.k.danger{border-left-color:var(--orange)}.k.danger b{color:var(--danger)}
.k.warn{border-left-color:var(--orange)}.k.warn b{color:var(--amber-ink)}
.bar{height:5px;border-radius:999px;background:var(--pale);margin-top:10px;overflow:hidden}
.bar>i{display:block;height:100%;background:linear-gradient(90deg,var(--emerald),var(--lime));transition:width .4s var(--ease)}

/* ── Listes clé/valeur (Périmètre du jour, Référentiel, Zones) ──────────── */
.kv{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:11px 0;border-top:1px solid #f2efe8;font-size:13px}
.kv:first-child{border-top:0}
.kv b{font-family:'IBM Plex Mono',monospace;font-weight:700;color:var(--forest);white-space:nowrap}
.kv .zn{display:inline-flex;align-items:center;white-space:nowrap;font-size:10.5px;font-weight:800;color:var(--muted);background:var(--mist);border-radius:999px;padding:3px 9px;margin-left:auto;margin-right:10px}

/* ── Encart dérive / mention (signal orange, surface contenue) ──────────── */
.encart{background:var(--orange-tint);border-radius:var(--r-sm);padding:12px 14px;font-size:12.5px;color:#7A5200;line-height:1.55}
.mention{margin-top:14px;font-size:12px;color:var(--muted);line-height:1.55}

/* ── Niveau 2 : à traiter ───────────────────────────────────────────────── */
.todo{display:flex;align-items:center;gap:12px;padding:11px 15px;border-top:1px solid #f2efe8;text-decoration:none;color:inherit;transition:background .14s var(--ease)}
.todo:first-child{border-top:0}
.todo:hover{background:var(--mist)}
.todo:focus-visible{outline:3px solid var(--emerald);outline-offset:-3px}
.todo .n{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;min-width:42px;font-family:'IBM Plex Mono',monospace;font-weight:800;font-size:17px;border-radius:var(--r-sm);padding:6px;flex:none}
.todo .tx{min-width:0;flex:1}
.todo .t{font-size:13px;font-weight:800;display:block;line-height:1.3}
.todo .d{font-size:11.5px;color:var(--muted);display:block;line-height:1.35}
.todo .pr{display:inline-flex;align-items:center;white-space:nowrap;flex:none;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;border-radius:999px;padding:4px 10px}
.todo .go{color:var(--emerald);font-weight:800;font-size:17px;flex:none}
.sev-hi .n{background:#fdeceb;color:var(--danger)}.sev-hi .pr{background:#fdeceb;color:var(--danger)}
.sev-md .n{background:var(--orange-tint);color:var(--amber-ink)}.sev-md .pr{background:var(--orange-tint);color:var(--amber-ink)}
.sev-lo .n{background:var(--pale);color:var(--pine)}.sev-lo .pr{background:var(--pale);color:var(--pine)}
.more{width:100%;min-height:44px;border:0;border-top:1px solid #f2efe8;background:#fbfdfa;color:var(--pine);font-weight:800;font-size:12.5px;cursor:pointer;font-family:inherit}
.more:hover{background:var(--mist)}
.more:focus-visible{outline:3px solid var(--emerald);outline-offset:-3px}

.mk{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.mk>div{border:1px solid var(--line);border-left:3px solid var(--emerald);border-radius:var(--r-sm);padding:11px 12px}
.mk small{display:block;color:var(--muted);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.04em;line-height:1.35}
.mk b{display:block;margin-top:7px;font-size:22px;color:var(--forest);font-family:'IBM Plex Mono',monospace}
/* Trois compteurs côte à côte : « Contrôles ouverts » les pose à plat. */
.trio{display:flex;gap:26px;flex-wrap:wrap}
.trio>div b{display:block;font-family:'IBM Plex Mono',monospace;font-size:22px;font-weight:700;color:var(--forest)}
.trio>div small{font-size:12px;color:var(--muted)}
.trio>div.wa b{color:var(--orange)}

/* ── Tableaux ───────────────────────────────────────────────────────────── */
table{width:100%;border-collapse:collapse}
th{background:var(--forest);color:#d8ead3;font-size:10px;text-transform:uppercase;letter-spacing:.04em;padding:9px 8px;text-align:left;position:sticky;top:0;z-index:2;white-space:nowrap}
td{padding:9px 8px;border-top:1px solid #f2efe8;font-size:12.5px}
tbody tr:hover td{background:var(--mist)}
td.num,th.num{text-align:right;font-family:'IBM Plex Mono',monospace}
.neg{color:var(--danger);font-weight:800}
.pos{color:var(--pine);font-weight:800}
/* `tabindex="0"` sur le conteneur : une zone qui défile doit être atteignable
   au clavier, sinon son contenu est hors de portée sans souris (règle axe
   `scrollable-region-focusable`). D'où aussi un focus visible. */
.scroll{max-height:52vh;overflow:auto;-webkit-overflow-scrolling:touch}
.scroll:focus-visible{outline:3px solid var(--emerald);outline-offset:-3px}
.tools{display:flex;gap:8px;flex-wrap:wrap;padding:10px 15px;border-bottom:1px solid var(--line);background:#fbfdfa}
.tools input,.tools select{min-height:44px;border:1px solid #dbe6d9;border-radius:var(--r-sm);padding:0 11px;font-size:12.5px;font-family:inherit;color:var(--ink);background:#fff}
.tools input{flex:1;min-width:150px}
.att{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;margin-left:7px;font-size:10px;font-weight:800;color:var(--amber-ink);text-transform:uppercase;letter-spacing:.04em;vertical-align:middle}
.att i{width:7px;height:7px;border-radius:50%;background:var(--orange);display:block;flex:none}
.att.crit{color:var(--danger)}.att.crit i{background:var(--danger)}
/* Pastilles : `inline-flex` + `nowrap`, sinon un libellé de deux mots sort de
   la pastille et se coupe en deux lignes dans une cellule étroite. */
.badge{display:inline-flex;align-items:center;white-space:nowrap;border-radius:999px;padding:3px 10px;font-size:10.5px;font-weight:800;margin:1px 2px 1px 0}
.bhi{background:#fdeceb;color:var(--danger)}
.bmd{background:var(--orange-tint);color:var(--amber-ink)}
.blo{background:var(--pale);color:var(--pine)}

/* ── Référentiel terrain compacté ───────────────────────────────────────── */
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}
.stats>div{background:#fff;padding:11px 12px;min-width:0}
/* Huit indicateurs dans une grille de trois : la neuvième case resterait vide
   et, le fond du conteneur servant de filet, se verrait comme un bloc gris.
   Le dernier indicateur occupe donc la fin de sa ligne. */
.stats>div:last-child:nth-child(3n+2){grid-column:span 2}
.stats b{display:block;font-family:'IBM Plex Mono',monospace;font-size:17px;color:var(--forest);line-height:1.2;overflow-wrap:anywhere}
.stats small{display:block;color:var(--muted);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.04em;margin-top:3px;line-height:1.3}

/* ── Assistant IA ───────────────────────────────────────────────────────── */
.facts{display:flex;gap:9px;flex-wrap:wrap}
.chipa{display:inline-flex;align-items:center;white-space:nowrap;min-height:44px;border:1px solid #d8e6d6;background:#fff;color:var(--pine);border-radius:999px;padding:0 17px;font-size:12.5px;font-weight:700;cursor:pointer;font-family:inherit;transition:background .14s var(--ease)}
.chipa:hover{background:var(--mist)}
.chipa.on{background:var(--emerald);border-color:var(--emerald);color:#fff}
/* Carte réponse sur fond vert forêt : le module écrit dedans, on ne lui pose
   qu'un cadre. Son propre <h2> ferait double emploi avec l'en-tête d'onglet. */
#aflpIa>h2,#aflpPred>h2{display:none}
.repIa{margin-top:16px;background:var(--forest);border-radius:var(--r);padding:4px 6px}

/* ── Prévisions : grille de cartes, pas de sous-onglets ─────────────────── */
/* Le bandeau du module est violet et se répète dans chaque vue. Ici, un seul
   bandeau de page le remplace — même information, liseré orange, toujours à
   l'écran puisque l'onglet ne défile pas sous lui. */
#aflpPred .aflpp-tabs,#aflpPred .aflpp-bandeau{display:none}
.predban{background:var(--forest);border-left:4px solid var(--orange);border-radius:var(--r);padding:16px 20px;color:#EAF6EA}
.predban b{display:block;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--orange);font-weight:800;margin-bottom:8px}
.predban p{margin:0;font-size:13.5px;line-height:1.6}
.predban .meta{margin-top:12px;display:flex;gap:18px;flex-wrap:wrap;font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:var(--lime)}
.grille{margin-top:14px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.carte{display:flex;flex-direction:column;align-items:flex-start;gap:8px;text-align:left;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:15px 16px;cursor:pointer;box-shadow:var(--shadow);font-family:inherit;transition:box-shadow .2s var(--ease),border-color .2s var(--ease)}
.carte:hover{box-shadow:var(--shadow-lg)}
.carte[aria-pressed="true"]{border-color:var(--emerald);box-shadow:inset 3px 0 0 var(--emerald),var(--shadow)}
.carte .hd{display:flex;align-items:baseline;gap:9px}
.carte .no{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--muted)}
.carte .nm{font-family:'Archivo',Arial,sans-serif;font-size:14px;font-weight:700;color:var(--forest);line-height:1.3}

/* ── États : chargement / vide / hors-ligne / erreur ────────────────────── */
@keyframes cmdShimmer{0%{background-position:-400px 0}100%{background-position:400px 0}}
.skel{display:inline-block;height:14px;border-radius:6px;background:linear-gradient(90deg,#eef2ec 25%,#e2e9df 50%,#eef2ec 75%);background-size:800px 100%;animation:cmdShimmer 1.4s infinite linear;vertical-align:middle}
@media(prefers-reduced-motion:reduce){.skel{animation:none}}
.skrow{display:grid;grid-template-columns:44px 1fr;gap:12px;align-items:center;padding:11px 15px;border-top:1px solid #f2efe8}
.skrow:first-child{border-top:0}
.state{padding:30px 20px;text-align:center}
.state .ic{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;margin:0 auto 10px;font-size:21px;font-weight:800}
.state.ok .ic{background:#F1F9EF;color:#008F37}
.state.off .ic{background:#FDEFCE;color:#8a6a12}
.state.err .ic{background:#FBEAE7;color:#C0392B}
.state b{font-size:14.5px;color:#053B23;display:block}
.state p{margin:6px auto 12px;font-size:12.5px;color:#6b756e;max-width:46ch;line-height:1.55}
.state .act{display:inline-flex;align-items:center;white-space:nowrap;border:0;border-radius:var(--r-sm);padding:0 16px;min-height:44px;font-size:12.5px;font-weight:700;cursor:pointer;font-family:inherit;background:#008F37;color:#fff}
.state .act:hover{background:#00712C}
.netbar{display:flex;align-items:center;gap:9px;border-radius:var(--r-sm);padding:10px 13px;font-size:12.5px;font-weight:700;margin-bottom:14px;line-height:1.45}
/* `display:flex` est une règle d'AUTEUR : elle bat le `display:none` que le
   navigateur applique à `[hidden]`. Sans cette ligne, le bandeau réseau reste
   peint — vide, mais bordé et coloré — en haut du cockpit à chaque chargement
   en ligne, puisque `majReseau()` lui pose sa classe tout en le masquant. */
.netbar[hidden]{display:none}
.netbar.off{background:var(--orange-tint);border:1px solid #f0d99a;color:#6b5310}
.netbar.on{background:var(--pale);border:1px solid #c6e3c2;color:var(--pine)}

/* ── Adaptation : 4 → 2 → 1, 3 → 2 → 1 ─────────────────────────────────── */
@media(max-width:1080px){
  .c4,.c5,.c7,.c8{grid-column:span 6}
  .kpis{grid-template-columns:repeat(2,1fr)}
  .grille{grid-template-columns:repeat(2,1fr)}
  /* Le référentiel passe en 2 colonnes DÈS QUE sa colonne se réduit de moitié,
