# =============================================================================
# LBA Control · variables d'environnement
# =============================================================================
# Copiez ce fichier en `.env.local` puis renseignez vos valeurs.
# CE FICHIER NE DOIT JAMAIS CONTENIR DE SECRET : il est versionné.
#
# Rappel de sécurité : toute variable préfixée VITE_ est incluse dans le bundle
# JavaScript et donc PUBLIQUE. La clé `service_role` de Supabase ne doit jamais
# y figurer — elle contourne Row Level Security. Elle n'existe que côté serveur
# (Edge Functions, CI), et n'est jamais préfixée VITE_.
# =============================================================================

# URL du projet Supabase
VITE_SUPABASE_URL=

# Clé publiable (anon). Sans pouvoir propre : tout est protégé par RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Nom affiché avant la résolution du tenant (page de connexion générique)
VITE_APP_NAME=LBA Control

# --- Développement local uniquement ------------------------------------------
# PostgreSQL local utilisé par `npm run db:*` et les tests RLS.
LBA_PGHOST=/var/tmp
LBA_PGPORT=54329
LBA_PGDATABASE=lba_control
LBA_PGUSER=postgres
