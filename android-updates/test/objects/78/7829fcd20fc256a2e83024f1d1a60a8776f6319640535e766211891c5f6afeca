/* Rapports d'activité : compléments de mise en page (le reste vient d'operations.css). */
.rap-filters .ops-form-grid{grid-template-columns:repeat(auto-fill,minmax(180px,1fr))}
.rap-quick{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 12px}
.rap-quick .btn{padding:6px 12px;font-size:13px}
.rap-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.rap-status{margin-top:10px;font-size:13px;color:#4b5a52;min-height:18px}
.rap-kpis{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
.rap-kpis .kpi small{white-space:normal}
.rap-tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:6px;margin:0 0 10px;-webkit-overflow-scrolling:touch}
.rap-tabs button{flex:0 0 auto;border:1px solid #cfdcd3;background:#fff;border-radius:999px;padding:6px 12px;font:600 13px/1.2 'IBM Plex Sans',sans-serif;color:#053B23;cursor:pointer}
.rap-tabs button[aria-selected="true"]{background:#053B23;color:#fff;border-color:#053B23}
.rap-tabs button span{opacity:.75;font-weight:500;margin-left:4px}
.rap-table-wrap{overflow-x:auto;max-width:100%;border:1px solid #e3ebe6;border-radius:10px}
.rap-table-wrap table{min-width:640px;border-collapse:collapse;width:100%;font-size:12.5px}
.rap-table-wrap th{position:sticky;top:0;background:#eef4f0;text-align:left;white-space:nowrap;padding:6px 8px;border-bottom:1px solid #d6e2da}
.rap-table-wrap td{padding:5px 8px;border-bottom:1px solid #eef2ef;white-space:nowrap}
.rap-table-wrap td.num{text-align:right;font-variant-numeric:tabular-nums}
.rap-note{font-size:12.5px;color:#4b5a52;margin:8px 0 0}
.rap-print{display:none}
@media (max-width:600px){
  .rap-actions .btn{flex:1 1 calc(50% - 8px)}
  .rap-filters .ops-form-grid{grid-template-columns:1fr}
}
@media print{
  body>*{display:none!important}
  body>.rap-print{display:block!important;font:12px/1.4 'IBM Plex Sans',Arial,sans-serif;color:#000}
  .rap-print h1{font-size:18px;margin:0 0 4px}
  .rap-print h2{font-size:14px;margin:14px 0 6px}
  .rap-print table{border-collapse:collapse;width:100%;margin:4px 0}
  .rap-print th,.rap-print td{border:1px solid #999;padding:3px 6px;text-align:left}
  .rap-print td.num{text-align:right}
}
.kpi-grid.rap-kpis .kpi{min-height:0;padding:10px 12px}
.kpi-grid.rap-kpis .kpi b{font-size:22px}
@media (max-width:600px){.kpi-grid.rap-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}
