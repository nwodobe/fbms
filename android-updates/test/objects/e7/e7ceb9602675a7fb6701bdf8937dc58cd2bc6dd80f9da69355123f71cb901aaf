/* Zones AFLP : un cluster, sa zone, sa part de sacs. La part est une lecture
   du même agrégat `sacs cluster` exprimée en pourcentage du total affiché —
   pas un nouvel indicateur. */
function renderZones(){
  var z=zonesParCluster(),tot=SACS_ROWS.reduce(function(s,x){return s+Math.max(0,x.sac);},0);
  var lignes=CLUSTERS.slice().sort(function(a,b){
    return String(z[a.cle]||"~").localeCompare(String(z[b.cle]||"~"),"fr")||String(a.label).localeCompare(String(b.label),"fr");
  });
  if(!lignes.length){$("zonesTable").innerHTML='<div class="muted">Aucun cluster à répartir pour l\'instant.</div>';$("zonesResume").textContent="—";return;}
  $("zonesTable").innerHTML=lignes.map(function(x){
    var part=tot>0?Math.round(Math.max(0,x.sac)/tot*100)+" %":"—";
    return '<div class="kv"><span>'+esc(x.label)+'</span>'+
      '<span class="zn">'+esc(z[x.cle]||"—")+'</span><b>'+part+'</b></div>';
  }).join("");
  $("zonesResume").textContent=zonesConfirmees()?"répartition confirmée":"répartition à confirmer";
