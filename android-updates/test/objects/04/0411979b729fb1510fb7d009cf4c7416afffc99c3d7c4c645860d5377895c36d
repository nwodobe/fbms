/* ANAGROCI Operations Portal — redesign photographique premium */
.portal-page{background:radial-gradient(circle at 50% -10%,rgba(141,197,86,.14),transparent 34%),linear-gradient(180deg,#F6F9F6 0%,#EDF4EF 100%)}
.portal-wrap{max-width:1280px;padding-top:34px}
.portal-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:end;margin-bottom:24px}
.portal-head h1{font-size:38px;line-height:1.05;max-width:760px}
.portal-head p{font-size:14px;max-width:820px;line-height:1.55}
.portal-eyebrow{display:inline-flex;align-items:center;gap:8px;margin-bottom:10px;color:var(--emerald);font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
.portal-eyebrow::before{content:'';width:26px;height:3px;border-radius:999px;background:var(--lime)}
.portal-legend{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.portal-legend span{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:rgba(255,255,255,.74);backdrop-filter:blur(8px);border-radius:999px;padding:7px 10px;font-size:10px;color:var(--muted);font-weight:700}
.portal-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:18px;margin-top:0}
.portal-card{grid-column:span 2;padding:0;min-height:405px;border-left:0;border-radius:18px;overflow:hidden;box-shadow:0 12px 30px rgba(5,59,35,.08);position:relative;background:#fff;display:flex;flex-direction:column}
.portal-card:nth-child(4){grid-column:2/span 2}.portal-card:nth-child(5){grid-column:4/span 2}
.portal-card.signal{border-left:0}
.portal-card:hover{transform:translateY(-4px);box-shadow:0 20px 42px rgba(5,59,35,.14);border-color:#C8D9CD}
.portal-card-media{position:relative;aspect-ratio:16/9;overflow:hidden;background:#DDE8E0;flex:0 0 auto}
.portal-card-media::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 58%,rgba(5,59,35,.13) 100%);pointer-events:none}
.portal-card-media img{width:100%;height:100%;display:block;object-fit:cover;object-position:center;transition:transform .35s ease;filter:saturate(.92) contrast(1.02)}
.portal-card:hover .portal-card-media img{transform:scale(1.025)}
.portal-card-body{padding:18px 20px 19px;display:flex;flex-direction:column;flex:1;min-width:0}
.portal-card small{font-size:9.5px;letter-spacing:.12em;color:var(--emerald);margin:0}
.portal-card h2{font-size:21px;line-height:1.15;margin:9px 0 7px;letter-spacing:-.02em}
.portal-card p{font-size:12px;line-height:1.48;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.portal-card span{padding-top:16px;margin-top:auto;font-size:10.5px;display:inline-flex;align-items:center;gap:6px}
.portal-card span::after{content:'›';font-size:17px;line-height:1;transition:transform .16s ease}.portal-card:hover span::after{transform:translateX(3px)}
.portal-card.signal .portal-card-body{border-top:3px solid var(--orange)}
.portal-wide{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;margin-top:20px}
.portal-cross{min-height:178px;border-radius:18px;padding:0;overflow:hidden;position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,42%);align-items:stretch;background:var(--forest);box-shadow:0 12px 30px rgba(5,59,35,.1)}
.portal-cross.light{background:#fff;color:var(--forest)}
.portal-cross-content{padding:22px 22px 20px;display:flex;flex-direction:column;justify-content:center;min-width:0}
.portal-cross-content h3{font-size:19px;margin:0}.portal-cross-content p{font-size:11.5px;line-height:1.5;margin:7px 0 0;max-width:540px}.portal-cross-content b{margin-top:17px;font-size:10.5px}
.portal-cross-media{position:relative;overflow:hidden;min-height:178px;background:#193D2C}
.portal-cross-media::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,59,35,.26),transparent 48%)}
.portal-cross.light .portal-cross-media::after{background:linear-gradient(90deg,rgba(255,255,255,.38),transparent 52%)}
.portal-cross-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s ease;filter:saturate(.9) contrast(1.03)}
.portal-cross:hover .portal-cross-media img{transform:scale(1.025)}
.portal-architecture{margin-top:20px;padding:14px 17px;border-radius:14px;background:#EAF2F8;border:1px solid #CBDDEB;color:#2D658D;font-size:11.5px;line-height:1.5}
.portal-architecture b{color:#235979}
@media(max-width:1100px){.portal-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.portal-card,.portal-card:nth-child(4),.portal-card:nth-child(5){grid-column:auto}.portal-card:nth-child(5){grid-column:1/-1;max-width:calc(50% - 9px);width:100%;justify-self:center}.portal-card{min-height:390px}.portal-wide{grid-template-columns:1fr 1fr}.portal-cross{grid-template-columns:1fr}.portal-cross-media{min-height:145px;order:-1}}
@media(max-width:820px){.portal-head{grid-template-columns:1fr;gap:12px}.portal-head h1{font-size:32px}.portal-legend{justify-content:flex-start}.portal-grid{gap:14px}.portal-card:nth-child(5){max-width:none}.portal-wide{grid-template-columns:1fr}.portal-cross{grid-template-columns:minmax(0,1fr) minmax(190px,38%)}.portal-cross-media{order:initial;min-height:170px}}
@media(max-width:620px){.portal-wrap{padding-top:24px}.portal-head h1{font-size:28px}.portal-grid{grid-template-columns:1fr}.portal-card,.portal-card:nth-child(4),.portal-card:nth-child(5){grid-column:auto;max-width:none;min-height:0}.portal-card-media{aspect-ratio:16/8.7}.portal-card-body{padding:16px 17px 17px}.portal-card h2{font-size:20px}.portal-cross{grid-template-columns:1fr}.portal-cross-media{order:-1;min-height:150px}.portal-cross-content{padding:18px}.portal-legend span:nth-child(n+3){display:none}}
@media(prefers-reduced-motion:reduce){.portal-card,.portal-card-media img,.portal-cross-media img,.portal-card span::after{transition:none!important}.portal-card:hover{transform:none}.portal-card:hover .portal-card-media img,.portal-cross:hover .portal-cross-media img{transform:none}}
