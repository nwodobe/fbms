/* Fraîcheur de la donnée : un chiffre de ce tableau vieux de 40 minutes n'est
   pas une erreur, mais le BM doit le savoir avant de décider. */
function majFraicheur(){
  if(!LAST_LOAD)return;
  var min=Math.floor((Date.now()-LAST_LOAD)/60000);
  $("upd").textContent=min<1?"Actualisé à l'instant":("Actualisé il y a "+min+" min");
