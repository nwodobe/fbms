CLUSTERS=Object.values(cmap).filter(x=>x.vil||x.rt||x.vol||x.av).sort((a,b)=>b.vol-a.vol);renderClusters();
SACS_ROWS=CLUSTERS.map(x=>({cle:x.cle,label:x.label,sac:x.sac}));renderSacsCluster();renderZones();
RT_ROWS=rts.map(r=>{const k=String(r.id||keyc(rtLabel(r)));const av=avByRt[k]||0,paye=payeByRt[k]||0,rec=reconByRt[k],sac=sacRt[k]||0;const reasons=[];if(av>0&&(!rec||rec.statut!=="Réconcilié"))reasons.push("Caisse");if(sac<0)reasons.push("Sacs");if(av-paye<0)reasons.push("Dépassement");return{nom:up(rtLabel(r)),cluster:up(rtCluster(r,vills)),av:av,solde:av-paye,rec:rec,sac:sac,risk:reasons.length,reasons:reasons};}).filter(x=>x.risk||x.av>0).sort((a,b)=>(b.risk-a.risk)||(b.av-a.av)).slice(0,60);
