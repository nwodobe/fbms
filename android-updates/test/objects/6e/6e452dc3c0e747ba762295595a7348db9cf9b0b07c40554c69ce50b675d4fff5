/* Native Operations routes for Warehouse, Stock Transfer and Factory. */
(function(global){
'use strict';
var page=(document.body.dataset&&document.body.dataset.workspace)||'',root,sb;
function esc(v){return String(v==null?'':v).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
function n(v){var x=Number(v||0);return isFinite(x)?x:0;}function kg(v){return (n(v)/1000).toLocaleString('fr-FR',{maximumFractionDigits:1})+' MT';}function date(v){if(!v)return'—';try{return new Intl.DateTimeFormat('fr-FR').format(new Date(v));}catch(e){return esc(v);}}
function waitClient(){return new Promise(function(resolve){var k=0,t=setInterval(function(){k++;if(global.supabase&&global.ANAGROCI_SUPABASE_URL&&global.ANAGROCI_SUPABASE_ANON){clearInterval(t);resolve(global.supabase.createClient(global.ANAGROCI_SUPABASE_URL,global.ANAGROCI_SUPABASE_ANON));}else if(k>100){clearInterval(t);resolve(null);}},80);});}
async function q(t,c,l){if(!sb)return[];var r=await sb.from(t).select(c||'*').limit(l||300);return r.error?[]:(r.data||[]);}function route(){return(location.hash||'#overview').slice(1).split('/')[0]||'overview';}
function head(a,b){return '<div class="ops-route-head"><div><h1>'+esc(a)+'</h1><p>'+esc(b||'')+'</p></div></div>';}
function table(h,rs){if(!rs.length)return'<div class="ops-empty">Aucune donnée disponible.</div>';return'<div class="table-wrap"><table><thead><tr>'+h.map(function(x){return'<th>'+esc(x)+'</th>';}).join('')+'</tr></thead><tbody>'+rs.join('')+'</tbody></table></div>';}
function badge(s){var x=String(s||'').toUpperCase(),c=/ECART|BLOQ|REFUS/.test(x)?'danger':/RECU|CLOS|LIBER|ACTIF|OK/.test(x)?'ok':/TRANSIT|READY|ATTENT|PART/.test(x)?'warn':'info';return'<span class="badge '+c+'">'+esc(s||'—')+'</span>';}
async function transfer(){var r=route(),tr=await q('rcn_transferts','id,bin_id,destination,poids_envoye,poids_recu,ecart_kg,ecart_motif,etat,origin_site_code,origin_warehouse_code,destination_site_code,destination_warehouse_code,truck_plate,transporter,driver_name,seal_no,loaded_at,departed_at,arrived_at,reconciled_at,created_at',300);var filtered=tr;if(r==='ready')filtered=tr.filter(function(x){return/READY|PREPARE/i.test(x.etat||'');});if(r==='transit')filtered=tr.filter(function(x){return/TRANSIT|EXPED/i.test(x.etat||'');});if(r==='arrivals')filtered=tr.filter(function(x){return/ARRIV|RECU|RECEIVED/i.test(x.etat||'');});var titles={overview:'Stock Transfer',requests:'Transfer Requests',ready:'Ready to Load',transit:'In Transit',arrivals:'Arrivals',reconciliation:'Reconciliation',audit:'Audit'};root.innerHTML=head(titles[r]||titles.overview,'Mouvements inter-sites sans perte de généalogie. Une livraison LBA directe Factory ne crée pas de transfert artificiel.')+'<section class="card">'+table(['Transfer','Origin','Destination','BIN','Sent','Received','Variance','Truck','Status'],filtered.map(function(x){return'<tr><td class="mono">'+esc(x.id)+'</td><td>'+esc(x.origin_warehouse_code||x.origin_site_code||'—')+'</td><td>'+esc(x.destination_warehouse_code||x.destination_site_code||x.destination||'—')+'</td><td>'+esc(x.bin_id||'—')+'</td><td>'+kg(x.poids_envoye)+'</td><td>'+kg(x.poids_recu)+'</td><td>'+kg(x.ecart_kg)+'</td><td>'+esc(x.truck_plate||'—')+'</td><td>'+badge(x.etat)+'</td></tr>';}))+'</section>';}
/* Audit campagne 2027 : la Factory lit désormais le WMS (transferts vers l'entrepôt usine, lots et BIN usine),
   en plus des anciennes réceptions RCNTrace. Avant, seules rcn_receptions/rcn_v_lots étaient lues : un transfert
   réceptionné à YAK-FWH via Stock Transfer n'apparaissait jamais ici. Libellés FR/EN explicites. */
function L(fr,en){try{return localStorage.getItem('anagroci_lang')==='en'?en:fr;}catch(e){return fr;}}
async function qf(t,c,fn,l){if(!sb)return{rows:[],err:null};var b=sb.from(t).select(c||'*');if(fn)b=fn(b);var r=await b.limit(l||300);return{rows:r.error?[]:(r.data||[]),err:r.error?r.error.message:null};}
async function factory(){var r=route();
 var wh=await qf('wms_warehouses','id,code,name,is_factory',function(b){return b.eq('is_factory',true);},20);var fids=wh.rows.map(function(x){return x.id;});
 var trf=fids.length?await qf('wms_v_transfers','id,status,origin_code,dest_code,truck_plate,dispatched_qty,received_qty,variance_kg,bags_loaded,bags_received,departed_at,arrived_at,received_at,lot_count,anomaly',function(b){return b.in('dest_warehouse_id',fids).order('updated_at',{ascending:false});},200):{rows:[],err:null};
 var lots=fids.length?await qf('wms_v_lots','id,reception_id,warehouse_code,supplier_name,origin,current_kg,bin_kg,status,kor_final,moisture_final,created_at',function(b){return b.in('warehouse_id',fids);},300):{rows:[],err:null};
 var bins=fids.length?await qf('wms_v_bins','id,warehouse_code,stock_type,balance_kg,capacity_kg,occupancy_pct,contributors,status',function(b){return b.in('warehouse_id',fids);},300):{rows:[],err:null};
 var legacy=await qf('rcn_receptions','id,camion,fournisseur,arrivee_at,poids_annonce,sacs_annonce,etat,lot_id,site_code,warehouse_code,source_type',null,200);legacy.rows=legacy.rows.filter(function(x){return x.site_code==='YAKRO'||x.warehouse_code==='YAK-FWH';});
 var errs=[wh,trf,lots,bins].map(function(x){return x.err;}).filter(Boolean);
 var inTransit=trf.rows.filter(function(x){return/IN_TRANSIT|LOADED|ARRIVED/.test(x.status||'');}),received=trf.rows.filter(function(x){return/RECONCILED|CLOSED|DISCREPANCY|RESOLUTION/.test(x.status||'');});
 var stock=bins.rows.reduce(function(t,x){return t+n(x.balance_kg);},0)+lots.rows.reduce(function(t,x){return t+Math.max(0,n(x.current_kg)-n(x.bin_kg));},0);
 var kpi='<div class="kpi-grid">'+[[L('En route vers l’usine','On the way to the factory'),inTransit.length+' · '+kg(inTransit.reduce(function(t,x){return t+n(x.dispatched_qty);},0))],[L('Reçus à l’usine','Received at the factory'),received.length+' · '+kg(received.reduce(function(t,x){return t+n(x.received_qty);},0))],[L('Écarts à traiter','Variances to resolve'),String(trf.rows.filter(function(x){return/DISCREPANCY|RESOLUTION/.test(x.status||'');}).length)],[L('Stock usine (WMS)','Factory stock (WMS)'),kg(stock)]].map(function(k){return'<div class="kpi"><small>'+esc(k[0])+'</small><b>'+esc(k[1])+'</b></div>';}).join('')+'</div>';
 var tTrf=table([L('Transfert','Transfer'),L('Origine','Origin'),L('Destination','Destination'),L('Camion','Truck'),L('Envoyé','Sent'),L('Reçu','Received'),L('Écart','Variance'),L('Sacs env./reçus','Bags sent/received'),L('Statut','Status')],trf.rows.map(function(x){return'<tr><td class="mono"><a href="stock-transfer.html#requests">'+esc(x.id)+'</a></td><td>'+esc(x.origin_code||'—')+'</td><td>'+esc(x.dest_code||'—')+'</td><td>'+esc(x.truck_plate||'—')+'</td><td>'+kg(x.dispatched_qty)+'</td><td>'+(x.received_qty==null?'—':kg(x.received_qty))+'</td><td>'+(x.variance_kg==null?'—':n(x.variance_kg).toLocaleString('fr-FR')+' kg')+'</td><td>'+n(x.bags_loaded)+' / '+(x.bags_received==null?'—':n(x.bags_received))+'</td><td>'+badge(x.status)+'</td></tr>';}));
 var tLots=table(['LOT',L('Réception','Receipt'),L('Fournisseur / origine','Supplier / origin'),L('Stock','Stock'),'KOR',L('Humidité','Moisture'),L('Statut','Status')],lots.rows.map(function(x){return'<tr><td class="mono"><a href="traceability.html">'+esc(x.id)+'</a></td><td class="mono">'+esc(x.reception_id||'—')+'</td><td>'+esc((x.supplier_name||'—')+(x.origin?' · '+x.origin:''))+'</td><td>'+kg(x.current_kg)+'</td><td>'+(x.kor_final==null?'—':n(x.kor_final).toFixed(1))+'</td><td>'+(x.moisture_final==null?'—':n(x.moisture_final).toFixed(1)+' %')+'</td><td>'+badge(x.status)+'</td></tr>';}));
 var tBins=table(['BIN',L('Type','Type'),L('Stock','Stock'),L('Capacité','Capacity'),L('Remplissage','Fill'),L('Contributeurs','Contributors'),L('Statut','Status')],bins.rows.map(function(x){return'<tr><td class="mono">'+esc(x.id)+'</td><td>'+esc(x.stock_type||'—')+'</td><td>'+kg(x.balance_kg)+'</td><td>'+(x.capacity_kg?kg(x.capacity_kg):'—')+'</td><td>'+(x.occupancy_pct==null?'—':n(x.occupancy_pct).toFixed(1)+' %')+'</td><td>'+n(x.contributors)+'</td><td>'+badge(x.status)+'</td></tr>';}));
 var tLegacy=legacy.rows.length?'<h3 style="margin-top:16px">'+esc(L('Anciennes réceptions RCNTrace','Legacy RCNTrace receipts'))+'</h3>'+table([L('Réception','Receipt'),'Source',L('Fournisseur','Supplier'),L('Poids annoncé','Announced weight'),L('Sacs','Bags'),'LOT',L('Statut','Status')],legacy.rows.map(function(x){return'<tr><td class="mono">'+esc(x.id)+'</td><td>'+esc(x.source_type||'—')+'</td><td>'+esc(x.fournisseur||'—')+'</td><td>'+kg(x.poids_annonce)+'</td><td>'+n(x.sacs_annonce)+'</td><td>'+esc(x.lot_id||'—')+'</td><td>'+badge(x.etat)+'</td></tr>';})):'';
 var titles={overview:L('Usine · Yamoussoukro','Factory · Yamoussoukro'),reception:L('Réception usine','Factory reception'),warehouse:L('Magasin usine','Factory warehouse'),bins:L('BIN usine','Factory BIN'),processing:L('Process','Processing'),calibration:L('Calibrage','Calibration'),'mass-balance':L('Bilan matière','Mass balance'),audit:'Audit'};
 var body;
 if(r==='overview')body=kpi+'<section class="card"><h3>'+esc(L('Transferts vers l’usine','Transfers to the factory'))+'</h3>'+tTrf+'</section>';
 else if(r==='reception')body='<section class="card"><p class="muted">'+esc(L('La réception usine se fait dans Stock Transfer : « Arrivée » puis « Confirmer la réception ».','Factory receipt is done in Stock Transfer: “Arrival” then “Confirm receipt”.'))+' <a class="btn secondary" href="stock-transfer.html#arrivals">'+esc(L('Ouvrir les arrivées','Open arrivals'))+'</a></p>'+tTrf+tLegacy+'</section>';
 else if(r==='warehouse')body=kpi+'<section class="card"><h3>'+esc(L('Lots présents à l’usine','Lots at the factory'))+'</h3>'+tLots+'</section>';
 else if(r==='bins')body='<section class="card">'+tBins+'</section>';
 else body='<div class="ops-empty">'+esc(L('Arrivée usine ≠ entrée process. Les étapes industrielles (process, calibrage, bilan matière) seront activées à partir des SOP validés : rien n’est saisi ici pour l’instant.','Factory arrival ≠ process entry. Industrial steps (processing, calibration, mass balance) will be activated once SOPs are approved: nothing is recorded here yet.'))+'</div>';
 root.innerHTML=head(titles[r]||titles.overview,L('Magasin usine et process restent séparés. Les données viennent du WMS (transferts, lots, BIN).','Factory warehouse and process stay separate. Data comes from the WMS (transfers, lots, BINs).'))+
  '<div class="notice info"><b>'+esc(L('Process industriel non encore activé.','Industrial process not yet activated.'))+'</b>&nbsp;'+esc(L('Calibrage, décorticage et bilan matière seront ouverts après validation des procédures (SOP) usine. Factory couvre aujourd’hui : réception usine, magasin usine, BIN et transferts vers l’usine. Ce n’est pas une panne.','Calibration, shelling and mass balance will open once the factory SOPs are approved. Factory currently covers: factory reception, factory warehouse, BINs and transfers to the factory. This is not a fault.'))+'</div>'+(errs.length?'<div class="notice warn">'+esc(L('Certaines données n’ont pas pu être chargées. Réessayez ou contactez l’administrateur.','Some data could not be loaded. Retry or contact the administrator.'))+'</div>':'')+(/^<div class="ops-empty/.test(body)?'<section class="card">'+body+'</section>':body);}
async function render(){if(!root)return;root.innerHTML='<div class="empty">Chargement…</div>';if(page==='transfer')await transfer();else if(page==='factory')await factory();}
async function init(){root=document.getElementById('opsRouteView');sb=await waitClient();await render();global.ANAGROCI_OPS_ROUTE=render;}
if(['transfer','factory'].indexOf(page)<0)return;if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})(window);
