<?xml version="1.0" encoding="utf-8"?>
<!-- ANAGROCI FIELD BUYING · AFLP 2027 | Field Operations
     Permissions limitées au strict nécessaire :
       INTERNET / ACCESS_NETWORK_STATE : Supabase + détection en ligne / hors ligne
       ACCESS_FINE/COARSE_LOCATION     : GPS des parcelles et check-in (demandé au moment de l'usage)
       WRITE_EXTERNAL_STORAGE (≤ Android 9 seulement) : enregistrer les exports dans Téléchargements
     Aucune permission CAMERA : la photo passe par l'application Appareil photo du téléphone. -->
<!-- Identifiant, versions et SDK : définis UNE seule fois dans android/version.properties
     (lu par Gradle et par scripts/build-apk-local.sh). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.intent.action.GET_CONTENT" /><data android:mimeType="*/*" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
    </queries>

    <application
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <activity
            android:name="ci.anagroci.fieldbuying.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="ci.anagroci.fieldbuying.CaptureProvider"
            android:authorities="${applicationId}.capture"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
