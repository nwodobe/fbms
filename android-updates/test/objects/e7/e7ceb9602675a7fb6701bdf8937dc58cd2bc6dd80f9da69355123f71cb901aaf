async function loadAll(){if(!SB)return;$("upd").textContent="Chargement…";$("upd").className="upd";LAST_LOAD=0;LOAD_ERR=0;LOAD_DONE=false;setSkeletons();renderLocal();if(LOAD_TIMER)clearTimeout(LOAD_TIMER);LOAD_TIMER=setTimeout(function(){if(!LOAD_DONE)loadFailState();},8000);const [par,vills,rts,achats,avances,recons,sacs]=await Promise.all([q("parametres_calcul","cle,valeur"),q("villages","id,data",r=>r.eq("deleted",false)),q("rt","id,data,village_nom",r=>r.eq("deleted",false)),q("achats","poids_net,poids_brut,tare,montant,prix_kg,commission_rt,date,cluster,rt_id,rt_nom,village_nom,producteur_id,producteur_nom,refinancable,qualite_statut,statut_validation,numero_recu,humidite,kor,rejet,nb_sacs"),q("avances","date,montant,rt_id,rt_nom,cluster"),q("reconciliations","date,rt_id,rt_nom,cluster,statut,ecart,cash_restant,valeur_stock,created_at",r=>r.order("created_at",{ascending:false})),q("sacs_mouvements","date,type,source,destination,cluster,rt_id,rt_nom,producteur_id,producteur_nom,quantite")]);if(LOAD_TIMER)clearTimeout(LOAD_TIMER);LOAD_DONE=true;if(LOAD_ERR>0&&(vills.length+rts.length+achats.length+avances.length+recons.length+sacs.length)===0){loadFailState();return;}par.forEach(p=>{if(p.cle==="objectif_cout_kg"){const v=Number(p.valeur);if(v)OBJ_COUT=v;}});
